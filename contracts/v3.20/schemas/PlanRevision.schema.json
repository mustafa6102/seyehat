{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-seyahat:v3.20:PlanRevision",
  "title": "PlanRevision",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trip_id": {"type": "string", "minLength": 1, "readOnly": true},
    "version": {"type": "integer", "minimum": 1, "readOnly": true},
    "status": {"type": "string", "enum": ["CURRENT", "SUPERSEDED"], "x-lifecycle": "PlanRevisionStatus", "readOnly": true},
    "items": {"type": "array", "items": {"$ref": "./ItineraryItem.schema.json"}},
    "change": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_version": {"type": ["integer", "null"], "minimum": 1},
        "added_item_ids": {"type": "array", "items": {"type": "string"}},
        "removed_item_ids": {"type": "array", "items": {"type": "string"}},
        "moved_item_ids": {"type": "array", "items": {"type": "string"}},
        "updated_item_ids": {"type": "array", "items": {"type": "string"}, "description": "Items whose planning_duration was edited. Older revisions read as an empty list."},
        "reason_code": {"type": "string"}
      },
      "required": ["base_version", "added_item_ids", "removed_item_ids", "moved_item_ids", "updated_item_ids", "reason_code"]
    },
    "created_at": {"type": "string", "format": "date-time", "readOnly": true}
  },
  "required": ["trip_id", "version", "status", "items", "change", "created_at"],
  "x-contract-id": "SCH-PlanRevision",
  "x-version": "3.20",
  "x-status": "ACTIVE",
  "x-replaces": "urn:ai-seyahat:v3.18:PlanRevision",
  "x-requirement-refs": ["TRIP-BLD-001", "FR-TRIP-BLD-001-02", "AC-TRIP-BLD-001-02", "DAY-001", "RULE-DAY-001-01", "AC-DAY-001-01", "PLT-CONC-001", "NFR-CONC-001"],
  "x-open-decisions": ["ADR-010", "OD-013", "ADR-008"]
}
