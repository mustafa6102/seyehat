{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-seyahat:v3.19:OperationIdempotencyRecord",
  "title": "OperationIdempotencyRecord",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "principal_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operation": {"type": "string", "const": "refreshTripPlanItemGuide"},
    "trip_request_id": {"type": "string"},
    "item_id": {"type": "string"},
    "base_revision_version": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 255},
    "request_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"type": "string", "enum": ["IN_PROGRESS", "COMPLETED"]},
    "response_status": {"type": ["integer", "null"]},
    "response_json": {"type": ["object", "null"]}
  },
  "required": ["scope_hash", "principal_hash", "operation", "trip_request_id", "item_id", "base_revision_version", "idempotency_key", "request_fingerprint", "status", "response_status", "response_json"],
  "x-version": "3.19",
  "x-status": "ACTIVE",
  "x-audience": "INTERNAL",
  "x-retention-ref": "OD-013 / TripRequest lifecycle; no invented numeric duration"
}
