{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-seyahat:v3.14:AccommodationSearchJob",
  "title": "AccommodationSearchJob",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "search_id": {"type": "string"},
    "trip_request_id": {"type": "string"},
    "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "PARTIAL", "COMPLETED", "FAILED", "EXPIRED"], "x-lifecycle": "AccommodationSearchJobStatus"},
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {"offers": {"type": "array", "items": {"$ref": "./AccommodationOffer.schema.json"}}},
          "required": ["offers"]
        },
        {"type": "null"}
      ],
      "description": "Arama sonucu sıralaması öneri değildir; sıralama (RANK-001) kapsam dışıdır."
    },
    "error": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "properties": {"code": {"type": ["string", "null"]}, "message_tr": {"type": "string"}}, "required": ["code", "message_tr"]},
        {"type": "null"}
      ]
    },
    "expires_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "required": ["search_id", "trip_request_id", "status", "result", "error", "expires_at"],
  "x-contract-id": "SCH-AccommodationSearchJob",
  "x-version": "3.14",
  "x-status": "ACTIVE",
  "x-requirement-refs": ["ACC-001", "FR-ACC-001-03", "AC-ACC-001-04"],
  "x-open-decisions": ["OD-023", "OD-024"],
  "description": "ADR-011 asenkron iş + yoklama deseni; durumlar ve anlamları SCH-FlightSearchJob ile aynıdır."
}
