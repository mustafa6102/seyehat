{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-seyahat:v3.3:FareConditionSnapshot",
  "title": "FareConditionSnapshot",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "terms": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "value": {"type": ["string", "boolean", "integer", "null"]},
          "certainty": {"type": "string", "enum": ["EXACT", "ESTIMATED", "UNKNOWN"]},
          "source_reference": {"type": "string"},
          "fetched_at": {"type": "string", "format": "date-time"},
          "verified_at": {"type": ["string", "null"], "format": "date-time"},
          "expires_at": {"type": ["string", "null"], "format": "date-time"},
          "verification_status": {"type": "string", "enum": ["FRESH", "STALE", "EXPIRED", "UNVERIFIED"]}
        },
        "required": ["key", "value", "certainty", "source_reference", "fetched_at", "verified_at", "expires_at", "verification_status"],
        "allOf": [{"if": {"properties": {"certainty": {"const": "UNKNOWN"}}, "required": ["certainty"]}, "then": {"properties": {"value": {"type": "null"}}}}]
      }
    },
    "baggage": {"oneOf": [{"$ref": "./BaggageAllowance.schema.json"}, {"type": "null"}]}
  },
  "required": ["terms", "baggage"],
  "x-contract-id": "SCH-FareConditionSnapshot",
  "x-version": "3.3",
  "x-status": "ACTIVE",
  "x-requirement-refs": ["FLT-REPRICE-001", "RULE-FLT-REPRICE-001-03", "AC-FLT-REPRICE-001-06"]
}
