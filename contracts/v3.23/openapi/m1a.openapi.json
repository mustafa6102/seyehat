                "schema": {
                  "$ref": "../schemas/TripRequestFlightSelection.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "TripRequest yok veya henüz uçuş seçilmedi. RC-RESOURCE-NOT-FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/ErrorEnvelope.schema.json"
                }
              }
            }
          }
        },
        "x-od-022-note": "v3.23: yanıt şeması referansı v3.23 FlightOffer zincirine geçti; parametre, durum kodu ve davranış değişmedi."
      },
      "put": {
        "operationId": "selectTripRequestFlight",
        "x-contract-id": "OP-selectTripRequestFlight",
        "x-status": "ACTIVE",
        "x-requirement-refs": [
          "FLT-REPRICE-001",
          "RULE-FLT-REPRICE-001-04",
          "RULE-FLT-REPRICE-001-05",
          "RULE-FLT-REPRICE-001-06",
          "FR-FLT-REPRICE-001-02",
          "AC-FLT-REPRICE-001-08",
          "AC-FLT-REPRICE-001-09",
          "AC-FLT-REPRICE-001-12",
          "AC-FLT-REPRICE-001-13",
          "RULE-FLT-REPRICE-001-08",
          "AC-FLT-REPRICE-001-15"
        ],
        "x-open-decisions": [
          "OD-021",
          "ADR-010"
        ],
        "description": "Sunucuda saklanan kanonik teklifi TripRequest için seçer (TRN-FSEL-01). İstek yalnız teklif kimliğini ve kullanıcının gördüğü doğrulama zamanını taşır; fiyat ve uçuş verisi tarayıcıdan kabul edilmez. Koşullar: teklif bu TripRequest'in bir uçuş arama sonucunda yer almalı, sunucudaki en son doğrulama sonucu CURRENT olmalı (veya CHANGED ve accept_changed_offer=true), süresi dolmamış olmalı ve expected_verified_at bu sonucun captured_at değerine eşit olmalıdır. Başarılı seçim mevcut seçimin yerine geçer.",
        "parameters": [
          {
            "name": "tripRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "offer_id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "SCH-FlightOffer.provider_offer_id; yalnız tanımlayıcıdır."
                  },
                  "expected_verified_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Kullanıcıya gösterilen doğrulama sonucunun captured_at değeri."
                  },
                  "accept_changed_offer": {
                    "type": "boolean",
                    "default": false,
                    "description": "En son sonuç CHANGED ise yeni doğrulanmış teklifin açık kabulü."
                  }
                },
                "required": [
                  "offer_id",
                  "expected_verified_at"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seçim CURRENT olarak saklandı.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../schemas/TripRequestFlightSelection.schema.json"
                }
              }
            }
          },
          "400": {
            "description": "Eksik Idempotency-Key veya istek sözleşmeye uymuyor. RC-VALIDATION-SCHEMA.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/ErrorEnvelope.schema.json"
                }
              }
            }
          },
          "404": {
            "description": "TripRequest veya sunucuda saklı teklif bulunamadı. RC-RESOURCE-NOT-FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/ErrorEnvelope.schema.json"
                }
              }
            }
          },
          "409": {
            "description": "Seçim yapılmadı; mevcut seçim değişmedi. OFFER_NOT_SELECTABLE (teklif bu TripRequest'in arama sonucu değil, en son sonuç UNVERIFIED veya doğrulama yok); OFFER_CHANGED (sonuç CHANGED ve açık kabul yok, ya da expected_verified_at uyuşmuyor); OFFER_EXPIRED (teklif süresi dolmuş); IDEMPOTENCY_KEY_CONFLICT (anahtar farklı bir istek için kullanılmış).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "../../schemas/ErrorEnvelope.schema.json"
                }
              }
            }
          }
        },
        "x-od-022-note": "v3.23: yanıt şeması referansı v3.23 FlightOffer zincirine geçti; parametre, durum kodu ve davranış değişmedi."
      }
    },
