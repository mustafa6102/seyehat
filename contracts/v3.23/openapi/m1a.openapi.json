    "/trip-requests/{tripRequestId}/flight-selection": {
      "get": {
        "operationId": "getTripRequestFlightSelection",
        "x-contract-id": "OP-getTripRequestFlightSelection",
        "x-status": "ACTIVE",
        "x-requirement-refs": [
          "FLT-REPRICE-001",
