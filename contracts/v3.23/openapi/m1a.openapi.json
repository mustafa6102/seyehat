          "ADR-010"
        ],
        "description": "TripRequest'in uçuş seçimini döndürür. Durum okuma anında değerlendirilir; expires_at geçmişse seçim EXPIRED olarak döner (TRN-FSEL-03). Seyahat Planım ekranı seçili uçuşu, verified_price, verified_at ve status alanlarını bu kayıttan gösterir.",
        "parameters": [
          {
            "name": "tripRequestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
