APP_NAME="AI Travel Planner"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Temporary production diagnostics. Keep disabled and set the token only in the deployment environment.
DIAGNOSTICS_ENABLED=false
DIAGNOSTICS_TOKEN=

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# GeoNames location catalog (TRIP-001 UI). Free account: https://www.geonames.org/login
# The username is the only value you must obtain; it stays server-side. Empty = search disabled.
GEONAMES_USERNAME=
GEONAMES_BASE_URL=https://secure.geonames.org
GEONAMES_MIN_QUERY_LENGTH=2
GEONAMES_MAX_QUERY_LENGTH=80
GEONAMES_MAX_ROWS=10
# GeoNames-only resilience profile (free tier: 1000 credits/hour, 10000/day; 1 credit/request).
GEONAMES_POLICY_VERSION=geonames-ops-2026-09-28
GEONAMES_TIMEOUT_MS=2000
GEONAMES_RETRY_MAX_ATTEMPTS=2
GEONAMES_RETRY_BASE_DELAY_MS=200
GEONAMES_RETRY_MAX_DELAY_MS=1000
GEONAMES_CIRCUIT_FAILURE_THRESHOLD=5
GEONAMES_CIRCUIT_OPEN_SECONDS=60
GEONAMES_RATE_LIMIT_MAX_REQUESTS=375
GEONAMES_RATE_LIMIT_PER_SECONDS=3600

# Duffel Places (flight location discovery only; OD-022 v3.8). Token stays server-side.
# Search stays disabled until a token is set and the duffel_places resilience profile below is complete.
DUFFEL_ACCESS_TOKEN=
DUFFEL_BASE_URL=https://api.duffel.com
DUFFEL_VERSION=v2
# duffel_places deploy-time profile (config/provider_resilience.php); every value must be a positive integer,
# otherwise the profile is invalid and location discovery fails closed.
DUFFEL_PLACES_POLICY_VERSION=duffel-places-ops-2026-09-29
DUFFEL_PLACES_TIMEOUT_MS=2000
DUFFEL_PLACES_RETRY_MAX_ATTEMPTS=2
DUFFEL_PLACES_RETRY_BASE_DELAY_MS=200
DUFFEL_PLACES_RETRY_MAX_DELAY_MS=1000
DUFFEL_PLACES_CIRCUIT_FAILURE_THRESHOLD=5
DUFFEL_PLACES_CIRCUIT_OPEN_SECONDS=60
DUFFEL_PLACES_RATE_LIMIT_MAX_REQUESTS=50
DUFFEL_PLACES_RATE_LIMIT_PER_SECONDS=60

# Duffel Flights. ALL_ADULT is only the explicit compatibility policy for legacy count-only TripRequests.
# New passenger_composition searches do not derive their composition from this value.
DUFFEL_FLIGHTS_PASSENGER_POLICY=
DUFFEL_FLIGHTS_MAX_OFFERS=20
DUFFEL_FLIGHTS_POLICY_VERSION=duffel-flights-ops-2026-09-29
DUFFEL_FLIGHTS_TIMEOUT_MS=30000
DUFFEL_FLIGHTS_RETRY_MAX_ATTEMPTS=1
DUFFEL_FLIGHTS_RETRY_BASE_DELAY_MS=200
DUFFEL_FLIGHTS_RETRY_MAX_DELAY_MS=1000
DUFFEL_FLIGHTS_CIRCUIT_FAILURE_THRESHOLD=5
DUFFEL_FLIGHTS_CIRCUIT_OPEN_SECONDS=60
DUFFEL_FLIGHTS_RATE_LIMIT_MAX_REQUESTS=20
DUFFEL_FLIGHTS_RATE_LIMIT_PER_SECONDS=60

# duffel_stays accommodation search (OD-023). Every DUFFEL_STAYS_* policy value must be set, otherwise Stays is never called.
DUFFEL_STAYS_MAX_PROPERTIES=
DUFFEL_STAYS_POLICY_VERSION=
DUFFEL_STAYS_TIMEOUT_MS=
DUFFEL_STAYS_RETRY_MAX_ATTEMPTS=
DUFFEL_STAYS_RETRY_BASE_DELAY_MS=
DUFFEL_STAYS_RETRY_MAX_DELAY_MS=
DUFFEL_STAYS_CIRCUIT_FAILURE_THRESHOLD=
DUFFEL_STAYS_CIRCUIT_OPEN_SECONDS=
DUFFEL_STAYS_RATE_LIMIT_MAX_REQUESTS=
DUFFEL_STAYS_RATE_LIMIT_PER_SECONDS=

# PLT-PII-001 access records (metadata only); dedicated channel so LOG_LEVEL cannot drop them.
PII_ACCESS_LOG_STREAM=php://stderr
